{
  "name": "agent-collab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Anton Shalin <anton.shalin@gmail.com>",
  "type": "module",
  "bin": {
    "agent-collab": "scripts/agent-collab-launcher.mjs",
    "agent-collab-eval": "scripts/agent-collab-eval-launcher.mjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:flow": "node scripts/run-bounded-tests.mjs",
    "map:verify": "mapify check-installed . && mapify check && npm run build --silent && node dist/flow/map-admin-cli.js verify .",
    "map:update": "tsx src/flow/map-update-cli.ts candidate .",
    "map:auto-update": "npm run map:update",
    "map:project:codex": "npm run build --silent && node dist/flow/map-admin-cli.js project codex .",
    "map:project:grok": "npm run build --silent && node dist/flow/map-admin-cli.js project grok .",
    "map:project:claude": "npm run build --silent && node dist/flow/map-admin-cli.js project claude .",
    "eval": "node scripts/agent-collab-eval-launcher.mjs",
    "start": "node scripts/agent-collab-launcher.mjs"
  },
  "dependencies": {
    "@dagrejs/graphlib": "4.0.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "canonicalize": "4.0.0",
    "execa": "10.0.1",
    "tsx": "4.22.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
