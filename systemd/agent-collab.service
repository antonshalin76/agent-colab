[Unit]
Description=Codex, Grok, and Claude review-only collaboration worker
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/Source/agent-collab
ExecStartPre=/usr/bin/env node %h/Source/agent-collab/scripts/agent-collab-launcher.mjs review-readiness
ExecStart=/usr/bin/env node %h/Source/agent-collab/scripts/agent-collab-launcher.mjs review-worker
Restart=always
RestartSec=3
TimeoutStopSec=35
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
Environment=AGENT_COLLAB_STATE_DIR=%h/.local/share/agent-collab
Environment=AGENT_COLLAB_GROK_BIN=%h/.local/bin/grok
Environment=AGENT_COLLAB_CLAUDE_BIN=%h/.local/bin/claude
Environment=AGENT_COLLAB_CODEX_BIN=%h/.local/bin/codex
Environment=AGENT_COLLAB_ALLOWED_ROOTS=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
